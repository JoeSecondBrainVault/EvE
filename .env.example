# Copy to .env and fill in. NEVER commit .env.
# Secrets (GEMINI_API_KEY) are better set as Windows user environment variables - see README.

# --- Server (Phase 1) ---
EVE_HOST=127.0.0.1
EVE_PORT=8765

# --- Speech-to-text (Phase 1) ---
# large-v3-turbo on the RTX 4060; use "small" for CPU-only machines.
EVE_WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu
EVE_WHISPER_DEVICE=auto
# Leave empty for auto-detect (needed for mixed Bisaya/English/Tagalog).
EVE_LANGUAGE=
# Extra words that help Whisper spell course terms correctly (comma separated).
EVE_VOCABULARY=subnetting, OSI model, Laravel, database normalization

# --- Capture (Phase 1) ---
EVE_CAPTURE_LOOPBACK=true
EVE_CAPTURE_MIC=true
